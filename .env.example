# Officer console login. Without OFFICER_PASSWORD a demo account (shown on the login page) is used.
OFFICER_USER=officer
OFFICER_PASSWORD=
OFFICER_NAME=Duty Officer
# Signs login tokens. Unset = random per start (everyone is signed out on restart).
SAMAJSEVAK_SECRET=

# Escalation periods in hours for Complaint, Warning, Strike 1, Strike 2 (same for every category).
# Unset = scaled to each category's SLA (see ESCALATION_STAGES in backend/app/knowledge.py).
SAMAJSEVAK_STAGE_HOURS=

# Multilingual embeddings (about 240 MB of model files, about 0.5 GB RAM). 0 = TF-IDF only.
SAMAJSEVAK_EMBEDDINGS=1

# Optional — the platform works fully offline without these.
# With a key: AI-drafted replies and the photo-evidence check.
GEMINI_API_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
